smn:PinkSalmon a skos:Concept ;
  skos:prefLabel "Pink Salmon"@en ;
  skos:altLabel "Humpback Salmon"@en ;
  skos:broader smn:SalmonSpecies ;
  skos:inScheme smn:SalmonSpeciesScheme ;
  skos:definition "The Pacific salmon species Oncorhynchus gorbuscha."@en ;
  skos:scopeNote "Pink Salmon have a fixed two-year life cycle, so their populations divide into an odd-year and an even-year line. State the line with a concept from smn:CycleLineScheme; the DFO codes PKO and PKE encode both facts at once."@en ;
  rdfs:seeAlso <http://purl.obolibrary.org/obo/NCBITaxon_8017> ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Species axis of the DFO Conservation Unit species-code list, codes PKE and PKO."@en ;
  dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/facts-infos-eng.html> .

