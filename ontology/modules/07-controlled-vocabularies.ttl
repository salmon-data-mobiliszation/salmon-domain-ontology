  skos:notation "1"^^xsd:integer ;
  skos:broader smn:AgeClassValue ;
  skos:inScheme smn:AgeClassValueScheme ;
  skos:definition "Age-component value of 1 year."@en ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Migrated and relabeled from GC DFO Salmon Ontology term gcdfo:Age1YearClass."@en ;
  dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> .

smn:AgeClassValue2 a skos:Concept ;
  skos:prefLabel "Age-class value 2 years"@en ;
  skos:notation "2"^^xsd:integer ;
  skos:broader smn:AgeClassValue ;
  skos:inScheme smn:AgeClassValueScheme ;
