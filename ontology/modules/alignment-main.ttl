@prefix smn:  <https://w3id.org/smn/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
@prefix ro:      <http://purl.obolibrary.org/obo/RO_> .
@prefix gcdfo:   <https://w3id.org/gcdfo/salmon#> .
@prefix odo:     <http://purl.dataone.org/odo/> .
@prefix qk:      <http://qudt.org/vocab/quantitykind/> .

<https://w3id.org/smn/modules/alignment-main> a owl:Ontology ;
  rdfs:label "Salmon Domain Ontology Alignment Module (main-candidate)"@en ;
  rdfs:comment "Conservative upper-level alignment bridges adapted from DFO Salmon Ontology alignment branch (feat/alignment-modules-main-research)."@en ;
  owl:imports <https://w3id.org/smn> .

#################################################################
# Conservative class bridges
#################################################################

smn:SurveyEvent skos:closeMatch <http://www.w3.org/ns/sosa/Sampling> .
smn:EscapementSurveyEvent skos:closeMatch <http://www.w3.org/ns/sosa/Sampling> .
smn:EscapementMeasurement skos:closeMatch <http://www.w3.org/ns/sosa/Result> .

smn:ReportingOrManagementStratum skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .
smn:Stock skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .
smn:IndicatorRiver skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .

smn:ReferencePoint skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .
smn:FisheriesReferencePointLower skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .

smn:Abundance skos:closeMatch qk:Population ;
  skos:broadMatch qk:Count ;
  rdfs:seeAlso dwc:individualCount .

smn:YearBasis skos:closeMatch gcdfo:YearBasis .
smn:BroodYearBasis skos:closeMatch gcdfo:BroodYear, odo:SALMON_00000520 .
smn:ReturnYearBasis skos:closeMatch gcdfo:ReturnYear .
smn:CatchYearBasis skos:closeMatch gcdfo:CatchYear .

smn:AgeNotation skos:closeMatch gcdfo:AgeNotation .
smn:GilbertRichAgeNotation skos:closeMatch gcdfo:GilbertRichAgeNotation .
smn:EuropeanAgeNotation skos:closeMatch gcdfo:EuropeanAgeNotation .

smn:AgeBasis skos:closeMatch gcdfo:AgeBasis .
smn:AgeAtReturnBasis skos:closeMatch gcdfo:AgeAtReturnBasis .
smn:AgeAtMaturityBasis skos:closeMatch gcdfo:AgeAtMaturityBasis .
smn:AgeAtSamplingBasis skos:closeMatch gcdfo:AgeAtSamplingBasis .

smn:AgeDimension skos:closeMatch gcdfo:AgeDimension .
smn:TotalAgeDimension skos:closeMatch gcdfo:TotalAgeDimension .
smn:FreshwaterAgeDimension skos:closeMatch gcdfo:FreshwaterAgeDimension .
smn:OceanAgeDimension skos:closeMatch gcdfo:OceanAgeDimension .

smn:AgeClassValue skos:closeMatch gcdfo:AgeClassValue .
smn:AgeClassValue1 skos:closeMatch gcdfo:Age1YearClass .
smn:AgeClassValue2 skos:closeMatch gcdfo:Age2YearClass .
smn:AgeClassValue3 skos:closeMatch gcdfo:Age3YearClass .
smn:AgeClassValue4 skos:closeMatch gcdfo:Age4YearClass .
smn:AgeClassValue5 skos:closeMatch gcdfo:Age5YearClass .
smn:AgeClassValue6 skos:closeMatch gcdfo:Age6YearClass .
smn:AgeClassValue7 skos:closeMatch gcdfo:Age7YearClass .

smn:AgeNotationScheme rdfs:seeAlso gcdfo:AgeNotationScheme .
smn:AgeBasisScheme rdfs:seeAlso gcdfo:AgeBasisScheme .
smn:AgeDimensionScheme rdfs:seeAlso gcdfo:AgeDimensionScheme .
smn:AgeClassValueScheme rdfs:seeAlso gcdfo:AgeClassValueScheme .

#################################################################
# Safe property reuse links
#################################################################

smn:hasDeme rdfs:subPropertyOf ro:0002351 .
smn:hasPopulation rdfs:subPropertyOf ro:0002351 .

#################################################################
# Representation-level bridges
#################################################################

<http://www.w3.org/ns/sosa/Sampling> skos:closeMatch dwc:Event .
<http://www.w3.org/ns/sosa/Sample> skos:closeMatch dwc:MaterialEntity .
<http://www.w3.org/ns/sosa/Observation> skos:closeMatch dwc:Occurrence .
<http://www.w3.org/ns/sosa/Procedure> skos:closeMatch <https://rs.tdwg.org/dwc/dp/terms/Protocol> .
